  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:browser": "node tests/browser/run.mjs",
    "notices": "node scripts/notices.mjs",
    "test:rust":"cargo test --manifest-path src-tauri/Cargo.toml --lib --locked",
    "gate": "npm run typecheck && npm run check && npm run test && npm run test:browser && npm run test:rust"
  },
  "dependencies": {
