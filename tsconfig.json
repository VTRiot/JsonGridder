{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "$lib": ["./vendor/svelte-jsoneditor/src/lib"],
      "$lib/*": ["./vendor/svelte-jsoneditor/src/lib/*"],
      "svelte-jsoneditor": ["./vendor/svelte-jsoneditor/src/lib/index.ts"],
      "svelte-jsoneditor/*": ["./vendor/svelte-jsoneditor/src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/unit/**/*.ts", "tests/browser/fixture/**/*.ts"]
}
