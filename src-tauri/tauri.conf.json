{
  "productName": "JsonGridder",
  "mainBinaryName": "JsonGridder",
  "version": "0.2.0",
  "identifier": "io.github.vtriot.jsongridder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "JsonGridder",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "create": false,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "VTRiot",
    "copyright": "Copyright (c) 2026 VTRiot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
